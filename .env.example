# Copy to .env.local for local development, and add the same names in
# Vercel → Project → Settings → Environment Variables for previews and production.
# Never commit real values: .env.local is git-ignored.

# ---- Hire Me: brief form (/hire → /api/contact) -----------------------------------------
# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=
# Where new briefs are sent (your inbox).
CONTACT_TO_EMAIL=
# The sender for both emails. Must be on a domain verified in Resend, e.g. "Yash Sharma <hello@yashify.tech>".
# Until a domain is verified, Resend's onboarding@resend.dev only delivers to your own address,
# so the auto-reply to visitors will fail (the brief to you still arrives).
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile: https://dash.cloudflare.com → Turnstile → add a widget for yashify.tech
# (and localhost). For local testing you can use Cloudflare's public test keys, which always pass:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Hire Me: booking and WhatsApp ------------------------------------------------------
# Your Cal.com booking page (https only). Opens in a new tab. Without it, "Book a call" opens an email.
NEXT_PUBLIC_CAL_URL=
# WhatsApp number in international format, digits only (e.g. 919876543210).
# Without it, the floating WhatsApp button is hidden.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---- Already used elsewhere on the site -------------------------------------------------
# NOTION_TOKEN=
# NOTION_DATABASE_ID=
# CRON_SECRET=
# NEXT_PUBLIC_NEWSLETTER_ENDPOINT=
# NEXT_PUBLIC_FESTIVE_END_DATE=   (optional, YYYY-MM-DD)
